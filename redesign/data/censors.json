 "sources": [
  {
   "id": "persian",
   "name": "Persian Government",
   "name_fa": "دولت ایران",
   "color": "#5b3f8c",
   "text": "The constitutional government’s control marks of 1910–1912, often reading ممیزی شد (momayezi shod, “inspected”); its censors during the First World War; and the numbered censors who read mail passing through Tehran in 1919–1921."
  },
  {
   "id": "kazerun",
   "name": "Kazerun nationalists",
   "name_fa": "ملیون کازرون",
   "color": "#8a6d1f",
   "text": "During the wartime rising in the south, the nationalists of Kazerun applied their own censor mark and overprinted stamps “Mellat-e Kazerun”."
  },
  {
   "id": "russian",
   "name": "Russian forces",
   "name_fa": "نیروهای روسیه",
   "color": "#b4532a",
   "text": "Marks attributed to Russian military censors in the north and west of Persia. Both attributions are provisional.",
   "provisional": true
  },
  {
   "id": "ottoman",
   "name": "Ottoman forces",
   "name_fa": "نیروهای عثمانی",
   "color": "#2f7d5b",
   "text": "Ottoman troops occupied western Persia in 1916–1917. This attribution is provisional.",
   "provisional": true
  },
  {
   "id": "british-south",
   "name": "British forces, south",
   "name_fa": "نیروهای بریتانیا در جنوب",
   "color": "#2e6fa7",
   "text": "Bushire was occupied by British forces in August 1915. Mail to and from the port and its hinterland was read by British censors there."
  },
  {
   "id": "indian-fpo",
   "name": "Indian field post",
   "name_fa": "پست صحرایی هند",
   "color": "#2e6fa7",
   "text": "Mail of the Indian Expeditionary Force, posted through its field post offices with Indian stamps."
  },
  {
   "id": "british-north",
   "name": "British forces, north",
   "name_fa": "نیروهای بریتانیا در شمال",
   "color": "#2e6fa7",
   "text": "Dunsterforce, then the North Persia Force, held the road from Baghdad to the Caspian. Their censors read civilian mail along it."
  },
  {
   "id": "reza-khan",
   "name": "Reza Khan’s army",
   "name_fa": "ارتش رضاخان",
   "color": "#4d5a70",
   "text": "Military censorship returned as Reza Khan’s army asserted central control over the south and west."
  },
  {
   "id": "unattributed",
   "name": "Not yet attributed",
   "name_fa": "نامشخص",
   "color": "#9aa3b2",
   "text": "Marks whose authority is still unknown. If you recognise one, please get in touch."
  }
 ]
